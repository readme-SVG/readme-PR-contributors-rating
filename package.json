{
  "name": "github-pr-stars-badge",
  "version": "2.0.0",
  "description": "Dynamic SVG badge showing top GitHub PRs sorted by repository stars",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readme-SVG/readme-PR-contributors-rating.git"
  },
  "bugs": {
    "url": "https://github.com/readme-SVG/readme-PR-contributors-rating/issues"
  },
  "homepage": "https://github.com/readme-SVG/readme-PR-contributors-rating#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "lint": "npm run check:syntax && npm run validate:i18n",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs"
  }
}
