# Local development environment template.
# Copy to `.env` and fill in the values you need; never commit the result.
#
#   cp .env.example .env

# --- Badge API (api/badge.js) ------------------------------------------------
# Personal access token used for GitHub GraphQL requests. Without it the badge
# falls back to anonymous rate limits (60 requests/hour per IP) and will
# throttle quickly. A classic token with no scopes is sufficient for public
# repository data.
GITHUB_TOKEN=

# --- AI change analysis (scripts/trigger_action.py) --------------------------
# Token with access to GitHub Models (or the configured inference endpoint).
GH_MODELS_TOKEN=

# Optional overrides for the inference backend.
# AI_ENDPOINT=https://models.github.ai/inference/chat/completions
# AI_MODEL=openai/gpt-4.1

# Comma-separated allow-list of GitHub logins permitted to trigger the
# analysis. An empty value allows every actor that can push to the repository.
# ALLOWED_USER=OstinUA,dependabot[bot]

# --- Label synchronization (scripts/sync_labels.py) --------------------------
# Set to "true" to delete repository labels that are absent from
# .github/labels.yml. Disabled by default because deletion is destructive.
# PRUNE_LABELS=false
